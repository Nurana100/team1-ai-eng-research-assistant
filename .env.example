# Template for the local .env file. Copy it, fill in what you use, keep the
# copy out of git:
#
#     cp .env.example .env
#
# Only .env.example belongs in the repository. A real key committed here is an
# automatic deduction, so double-check `git status` before every commit.

# --- LLM used for synthesis -------------------------------------------------
# One provider is enough; fill in the key that matches LLM_PROVIDER and leave
# the other two empty.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Web search backend -----------------------------------------------------
# Read by ai/sources.py when fetch_web runs.
#   tavily     - best results for research, 1000 requests/month free
#   serper     - Google-quality results, 2500 requests free
#   duckduckgo - no key at all, needs `pip install duckduckgo-search`
# duckduckgo is the default here so a fresh clone runs without signing up
# anywhere.
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Runtime settings -------------------------------------------------------
# These map one-to-one onto the fields of Settings in src/config.py.
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=86400
MAX_PARALLEL=5
